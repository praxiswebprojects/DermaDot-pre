{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dermadot-pre",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CONTACT_RECIPIENT": "aaweb.projects@gmail.com",
    "CONTACT_SENDER": "DermaDot <onboarding@resend.dev>",
    "NEXT_PUBLIC_SITE_URL": "https://dermadot.plus"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "observability": {
    "enabled": true
  }
}
