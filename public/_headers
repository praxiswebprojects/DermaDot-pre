# Keep content-hashed bundles cached until their URL changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Stable public filenames may be replaced between releases; use a bounded cache.
/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/cases/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/page-heroes/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
