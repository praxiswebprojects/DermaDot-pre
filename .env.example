
# Server-only Resend credentials and contact routing.
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
RESEND_API_KEY=re_your_resend_api_key
CONTACT_RECIPIENT=recipient@example.com
CONTACT_SENDER="DermaDot <contact@your-verified-domain.example>"

# Long random value used only to hash rate-limit visitor identifiers.
RATE_LIMIT_SALT=replace-with-an-independent-long-random-value
